#!/usr/bin/env sh
# pre-push hook: lint every commit about to leave this machine, the way the
# Lint workflow does on the push range. A subject that fails here would
# turn the push's Lint job red and could only be repaired by a force-push.
# Installed by `make hooks` (git config core.hooksPath scripts/githooks).
#
# stdin: one line per ref: <local ref> <local sha> <remote ref> <remote sha>
top=$(git rev-parse --show-toplevel)
zero=0000000000000000000000000000000000000000
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
    [ "$local_sha" = "$zero" ] && continue          # a deletion
    if [ "$remote_sha" = "$zero" ] || ! git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
        # A new remote branch, or a remote tip we do not have (force-push):
        # lint what is new against the stable branch, as the workflow does.
        base=$(git rev-parse --verify --quiet origin/main) || continue
        range="$base..$local_sha"
    else
        range="$remote_sha..$local_sha"
    fi
    python3 "$top/devtools/lint_commits.py" "$range" || status=1
done
[ "$status" -ne 0 ] && echo "pre-push: reword the commit(s) above before pushing (git rebase -i)." >&2
exit $status
