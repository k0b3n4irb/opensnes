# switch lowers to a compare chain (bne for the case, bcs to split the
# range); since L2 (2026-11-12) a dense one of four cases or more is a jump
# table (jump_table.checks), here test_fallthrough alone.
count 1 jmp \(@jtt
absent jmp \[
in test_simple_switch: present cmp\.w #1\n\tbeq @switch_case
# Fall-through cases 0/1/2 share ONE body: three slots of the table name it
# (until L2 the case labels were stacked on it).
in test_fallthrough: present \.dw @switch_case\.(\d+), @switch_case\.\1, @switch_case\.\1, @switch_case\.\d+\n
in test_fallthrough: absent lda #100[\s\S]*lda #100
# Sparse 16-bit values are compared directly (no table for 0x1000).
in test_sparse_values: present cmp\.w #4096
# A switch without default emits no default block.
in test_no_default: absent @switch_default
