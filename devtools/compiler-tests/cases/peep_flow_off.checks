env QBE_NO_PEEP_FLOW=1
# Since the 32-bit exact slot sharing (2026-10-25), the u16 -> u32 index's
# dead high word may land in a slot read elsewhere, so without the flow pass
# its `stz` and the reload after it stay too: one more store the pass removes.
in keep: present \tadc\.w #2\n\tsta\.b tcc__lf\+\d+\n(?:\tstz\.b tcc__lf\+\d+\n\tlda\.b tcc__lf\+\d+\n)?\tasl a\n\tsta\.b tcc__lf\+\d+\n\ttax
