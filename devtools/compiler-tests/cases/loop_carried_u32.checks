# f needs more than the 16 direct-page words: since 2026-11-04 (leaf_split)
# its costliest temps are in tcc__lf and the rest on the stack, so each slot
# operand below is either form. Loop body: 53 instructions all on the stack,
# 42 split.
# no phi moves before the back edge: the last thing the body does is n--
in f: absent \tlda (?:\d+,s|\.b tcc__lf\+\d+)\n\tsta (?:\d+,s|\.b tcc__lf\+\d+)\n\tlda (?:\d+,s|\.b tcc__lf\+\d+)\n\tsta (?:\d+,s|\.b tcc__lf\+\d+)\n\t(?:jmp @while_cond|bne @while_body)
in f: present \tdec(?: a\n\tsta \d+,s\n\tjmp @while_cond|\.b tcc__lf\+\d+\n\tbne @while_body)
# the identity half of `& 0x00FFFFFF` is not emitted, the high one is
in f: absent and\.w #65535
in f: present and\.w #255
# y += tab[i] in place: the sum is stored where y was read
in f: present \tadc( \d+,s|\.b tcc__lf\+\d+)\n\tsta\1\n
# point 3: the table value goes to the adc, not through a slot
in f: present \tlda\.l tab,x\n\tclc\n\tadc(?: \d+,s|\.b tcc__lf\+\d+)\n\tsta(?: \d+,s|\.b tcc__lf\+\d+)\n\tlda\.l tab\+2,x\n\tadc(?: \d+,s|\.b tcc__lf\+\d+)
# point 4: the u16 -> u32 index's high word is not written (no lda #0 in the loop body)
in f: absent \tasl a\n\tsta(?: \d+,s|\.b tcc__lf\+\d+)\n\tsta(?: \d+,s|\.b tcc__lf\+\d+)\n\tlda\.w #0
