# Since 2026-10-10 a phi and the value that feeds it share a slot when they
# can (see phi_share): the copies this case pins are the ones made when
# they cannot, so it is compiled with the sharing off.
env QBE_NO_PHI_SHARE=1
# Since 2026-10-10 a temporary that no call crosses lives in the direct page
# even in a function that calls (see dp_temps); the case pins the phi moves between stack slots.
env QBE_NO_DP_TEMPS=1
# Accumulators carried around a while(1) loop across calls (the
# button_test "maxraw" pattern): each update reads its own slot (\1), the
# new value (\2) is what the calls receive and what goes back to \1 on the
# back edge. No original check existed (opensnes-emu only compiled it).
# A: acc |= get_value(); use_value(acc).
in levelA_while_or: present jsl get_value\n\tora (\d+),s\n\tsta (\d+),s\n\tpha\n\tjsl use_value\n\tplx\n\tlda \2,s\n\tsta \1,s\n\tjmp @while_cond
# B: maxraw |= raw and frame + 1, both passed to use_value, both carried.
in levelB_while_two: present jsl get_value\n\tora (\d+),s\n\tsta (\d+),s\n[\s\S]*?lda \2,s\n\tpha\n\tjsl use_value\n[\s\S]*?lda \2,s\n\tsta \1,s\n\tjmp @while_cond
in levelB_while_two: present lda (\d+),s\n\tinc a\n\tsta (\d+),s\n[\s\S]*?lda \2,s\n\tpha\n\tjsl use_value\n[\s\S]*?lda \2,s\n\tsta \1,s\n
# C: the conditional call passes the updated maxraw.
in levelC_while_cond: present ora (\d+),s\n\tsta (\d+),s\n[\s\S]*?@if_true\.\d+:\n\tlda \2,s\n\tpha\n\tjsl use_value\n[\s\S]*?lda \2,s\n\tsta \1,s\n\tjmp @while_cond
in levelC_while_cond: present lda (\d+),s\n\tinc a\n\tsta (\d+),s\n\tpha\n\tjsl use_value\n\tplx\n\tlda \2,s\n\tsta \1,s\n
# D: toggled + 1 under a condition: both arms fill the merge slot (\2),
# which is passed to use_value and carried back.
in levelD_while_complex: present and\.w #128\n\tsta \d+,s\n\tbne \+\n\tlda (\d+),s\n\tsta (\d+),s\n\tjmp @if_false\.\d+\n\+\n@if_true\.\d+:\n\tlda \1,s\n\tinc a\n\tsta \d+,s\n\tsta \2,s\n[\s\S]*?lda \2,s\n\tpha\n\tjsl use_value\n\tplx\n\tlda \2,s\n\tsta \1,s\n
in levelD_while_complex: present ora (\d+),s\n\tsta (\d+),s\n[\s\S]*?lda \2,s\n\tsta \1,s\n\tjmp @while_cond
