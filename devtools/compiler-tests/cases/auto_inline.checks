# absorbed: no label, no call
raw absent \nclamp\.
raw absent \ninner\.
raw absent \nmiddle\.
raw absent \nlow\.
in once: absent jsl
in chain: absent jsl
in cut: absent jsl
# the byte parameter is cut
in cut: present and\.w #\$00FF
# kept: more than one call site, address used, recursion, an escaping local
raw present \ntwice\.auto_inline:
raw present \ntaken\.auto_inline:
raw present \ndown\.auto_inline:
raw present \nlocal\.auto_inline:
in two: present jsl twice[\s\S]*jsl twice
in rec: present jsl down
# `static inline` with two call sites: copied twice, gone
raw absent \npick\.
in both: absent jsl
# a leaf of some size IS poured into a caller that still calls (the rule
# that refused it is off by default since the evening of 2026-10-10; the
# case auto_inline_leaf_rule holds it under CC_INLINE_LEAF_MAX)
raw absent \nsweep\.
in boot: absent jsl sweep
raw absent \nsweep2\.
in alone: absent jsl
