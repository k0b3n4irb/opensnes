# if (long): both halves, straight in the branch (no 0/1 materialised)
in wide: present lda(?: \d+,s|\.b tcc__lf\+\d+)\n\tora(?: \d+,s|\.b tcc__lf\+\d+)\n\tbne @
in wide: absent lda\.w #1\n\+\+
# if ((short)long): the low word alone
in narrowed: absent ora
in narrowed: present lda(?: \d+,s|\.b tcc__lf\+\d+)\n\tbne @
# a long right of &&: compared in 32 bits (the high half is read)
# (offsets moved on 2026-10-08: promoted locals no longer take frame space)
# (no `cmp.w #0` after the load since 2026-10-10: the load set the flags)
in right_of_and: present lda(?: \d+,s|\.b tcc__lf\+\d+)\n\tbne \+
