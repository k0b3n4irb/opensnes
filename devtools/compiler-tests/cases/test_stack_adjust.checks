# Since 2026-10-10 a temporary that no call crosses lives in the direct page
# even in a function that calls (see dp_temps); the case pins how stack-relative offsets climb while arguments are pushed.
env QBE_NO_DP_TEMPS=1
# sp_adjust: locals sit at 12/14/16/18/20,s; each pha moves SP by 2, so
# the stack-relative loads must climb 12,16,20,24,28 as args are pushed.
in test_stack_adjust: present lda\.w ext_a\n\tsta 2,s
in test_stack_adjust: present lda 2,s\n\tpha\n\tlda 6,s\n\tpha\n\tlda 10,s\n\tpha\n\tlda 14,s\n\tpha\n\tlda 18,s\n\tpha\n\tjsl receiver
count 5 pha
# Five 2-byte args are popped with a 10-byte SP adjust after the call.
in test_stack_adjust: present jsl receiver\n\ttsa\n\tclc\n\tadc\.w #10\n\ttas
