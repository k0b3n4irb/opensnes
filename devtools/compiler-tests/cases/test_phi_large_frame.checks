# Many loop-carried accumulators in a large (100+ byte) frame, updated
# under conditions, the pattern of the original button_test bug. On the
# back edge, each accumulator's slot must receive the merge of ITS OWN
# update: the backreferences tie the source slot (\1), the merge slot
# (\2) and the write-back. No original check existed (opensnes-emu only
# compiled it).
# levelE: acc1-4 += 1, acc5-6 |= raw, acc7-8 += raw.
in levelE_many_acc: present and\.w #1\n\tsta \d+,s\n\tcmp\.w #0\n\tbne \+\n\tlda (\d+),s\n\tsta (\d+),s\n\tjmp @if_false\.\d+\n\+\n@if_true\.\d+:\n\tlda \1,s\n\tinc a\n\tsta \d+,s\n\tsta \2,s\n[\s\S]*?\tlda \2,s\n\tsta \1,s\n[\s\S]*?jmp @while_cond
in levelE_many_acc: present and\.w #2\n\tsta \d+,s\n\tcmp\.w #0\n\tbne \+\n\tlda (\d+),s\n\tsta (\d+),s\n\tjmp @if_false\.\d+\n\+\n@if_true\.\d+:\n\tlda \1,s\n\tinc a\n\tsta \d+,s\n\tsta \2,s\n[\s\S]*?\tlda \2,s\n\tsta \1,s\n[\s\S]*?jmp @while_cond
in levelE_many_acc: present and\.w #4\n\tsta \d+,s\n\tcmp\.w #0\n\tbne \+\n\tlda (\d+),s\n\tsta (\d+),s\n\tjmp @if_false\.\d+\n\+\n@if_true\.\d+:\n\tlda \1,s\n\tinc a\n\tsta \d+,s\n\tsta \2,s\n[\s\S]*?\tlda \2,s\n\tsta \1,s\n[\s\S]*?jmp @while_cond
in levelE_many_acc: present and\.w #8\n\tsta \d+,s\n\tcmp\.w #0\n\tbne \+\n\tlda (\d+),s\n\tsta (\d+),s\n\tjmp @if_false\.\d+\n\+\n@if_true\.\d+:\n\tlda \1,s\n\tinc a\n\tsta \d+,s\n\tsta \2,s\n[\s\S]*?\tlda \2,s\n\tsta \1,s\n[\s\S]*?jmp @while_cond
in levelE_many_acc: present and\.w #16\n\tsta \d+,s\n\tcmp\.w #0\n\tbne \+\n\tlda (\d+),s\n\tsta (\d+),s\n\tjmp @if_false\.\d+\n\+\n@if_true\.\d+:\n\tlda \d+,s\n\tora \1,s\n\tsta \d+,s\n\tsta \2,s\n[\s\S]*?\tlda \2,s\n\tsta \1,s\n[\s\S]*?jmp @while_cond
in levelE_many_acc: present and\.w #32\n\tsta \d+,s\n\tcmp\.w #0\n\tbne \+\n\tlda (\d+),s\n\tsta (\d+),s\n\tjmp @if_false\.\d+\n\+\n@if_true\.\d+:\n\tlda \d+,s\n\tora \1,s\n\tsta \d+,s\n\tsta \2,s\n[\s\S]*?\tlda \2,s\n\tsta \1,s\n[\s\S]*?jmp @while_cond
in levelE_many_acc: present and\.w #64\n\tsta \d+,s\n\tcmp\.w #0\n\tbne \+\n\tlda (\d+),s\n\tsta (\d+),s\n\tjmp @if_false\.\d+\n\+\n@if_true\.\d+:\n\tlda \d+,s\n\tclc\n\tadc \1,s\n\tsta \d+,s\n\tsta \2,s\n[\s\S]*?\tlda \2,s\n\tsta \1,s\n[\s\S]*?jmp @while_cond
in levelE_many_acc: present and\.w #128\n\tsta \d+,s\n\tcmp\.w #0\n\tbne \+\n\tlda (\d+),s\n\tsta (\d+),s\n\tjmp @if_false\.\d+\n\+\n@if_true\.\d+:\n\tlda \d+,s\n\tclc\n\tadc \1,s\n\tsta \d+,s\n\tsta \2,s\n[\s\S]*?\tlda \2,s\n\tsta \1,s\n[\s\S]*?jmp @while_cond
# levelF, flat conditions: e += raw, f |= lib, g += 1, h += raw, j |= raw, k += lib.
in levelF_stress: present and\.w #4\n\tsta \d+,s\n\tcmp\.w #0\n\tbne \+\n\tlda (\d+),s\n\tsta (\d+),s\n\tjmp @if_false\.\d+\n\+\n@if_true\.\d+:\n\tlda \d+,s\n\tclc\n\tadc \1,s\n\tsta \d+,s\n\tsta \2,s\n[\s\S]*?\tlda \2,s\n\tsta \1,s\n[\s\S]*?jmp @while_cond
