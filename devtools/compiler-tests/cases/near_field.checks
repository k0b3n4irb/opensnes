# four fields, each with its offset in the operand
in sum: present lda\.l \$000000,x
in sum: present \$000004,x
in sum: present \$000002,x
in sum: present \$000006,x
in sum: absent adc\.w #[246]\n
in set: present sta\.l \$000004,x
in set: present sta\.l \$000006,x
in set: absent pha
# two consecutive stores through the same pointer: X is loaded once
in set: present sta\.l \$000004,x\n\tsta\.l \$000006,x|sta\.l \$000004,x\n\tlda \d+,s\n\tsta\.l \$000006,x
# the 32-bit load reads through the 24-bit pointer
in next: present lda \[tcc__r9\]
in next: absent ,x
# the sign bit keeps its mask; the high byte of an unsigned value needs none
in sign_bit: present and\.w #1\n
in high_byte: absent and\.w #255
