# Since 2026-10-10 a temporary that no call crosses lives in the direct page
# even in a function that calls (see dp_temps); the case pins when a function that calls needs a stack frame.
env QBE_NO_DP_TEMPS=1
# intermediate-across-call needs a frame (sbc); tail-only call gets leaf_opt=1
in compute_across_call: present \bsbc\b
in compute_across_call: present jsl
in forward_with_work: present \bsbc\b
present forward_with_work.*leaf_opt=1
