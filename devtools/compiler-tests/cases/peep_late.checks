# the second access needs no reload at all: X is known across the label
# (peephole_xflow, 2026-10-13), and the addition reads tab,x as its operand
in index_x: absent \tldx
in index_x: absent \tlda\.b tcc__lf\+\d+\n\ttax\n\tlda
in index_x: present \tadc\.w tab,x\n
# 7 is loaded once for the two stores
in same_const: present \tlda\.w #7\n\tsta\.w flag_a\n\tsta\.w flag_b\n
# both loop variables start with a stz of their slot, and i++ is one inc
in count: present \tstz\.b tcc__lf\+\d+\n\tstz\.b tcc__lf\+\d+\n
in count: present \tinc\.b tcc__lf\+\d+\n
in count: absent \tinc a\n
# A is the return value: it is still loaded
in zero_and_return: present \tlda\.w #0\n\trtl
