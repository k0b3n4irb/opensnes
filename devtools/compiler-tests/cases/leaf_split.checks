# a leaf above 20 words: the costliest temps in tcc__lf, the overflow on the stack
# (leaf17 fits the 20 words since 2026-11-13: its whole frame is in tcc__lf)
in leaf17: present adc\.b tcc__lf\+\d+
in leaf17: present sta\.b tcc__lf\+\d+
in leaf17: absent \btas\b
in leaf21: present adc\.b tcc__lf\+\d+
in leaf25: present adc\.b tcc__lf\+\d+
in leaf25: present sta \d+,s
# the frame shrinks with them: 2 and 6 words left (was 21, 25); leaf21's two
# are the absorbed 32-bit index's, reserved and never touched
in leaf21: present sbc\.w #6\b
in leaf25: present sbc\.w #14\b
# an object on the stack: the whole frame stays there, as before
in leaf_arr: absent tcc__lf
in leaf_arr: present \btas\b
