# the shape pinned here is the text rules' and the slots' own: the X/Y colour
# (lot XY, 2026-11-14) would hold this case's counter or index in a register
# itself (its shapes: xy_colour.checks)
env QBE_NO_XY_COLOUR=1
in fill_words: absent asl a
in fill_words: present cpx\.w #128
in fill_words: absent #64
in every_third: absent asl a
in every_third: present adc\.w #6
in every_third: present cpx\.w #124
in mixed: present asl a
in mixed: present cmp\.w #64
in ramp: present asl a
in ramp: present c(?:mp|px|py)\.w #64
in fill_some: present asl a
