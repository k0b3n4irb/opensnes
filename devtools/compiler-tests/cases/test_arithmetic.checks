# 16-bit * / % by variables call the runtime with the right operands in
# the right places; constant cases fold or become shifts. No original check
# existed (opensnes-emu only compiled it). Operand order matters for / and %:
# the dividend (first argument, pushed first, so deeper: 6,s) goes to
# tcc__r0, the divisor (4,s) to tcc__r1.
in div_simple: present lda 6,s\n\tsta\.b tcc__r0\n\tlda 4,s\n\tsta\.b tcc__r1\n\tjsl __div16\n\trtl
in mod_simple: present lda 6,s\n\tsta\.b tcc__r0\n\tlda 4,s\n\tsta\.b tcc__r1\n\tjsl __mod16\n\trtl
# __mul16 takes its operands on the stack; the second push reads 2 bytes
# further up, and the caller pops both.
in mul_8x8_simple: present lda 4,s\n\tpha\n\tlda 8,s\n\tpha\n\tjsl __mul16\n\tplx\n\tplx\n\trtl
# (a * b) / c: the product in A becomes the dividend.
in combined_mul_div: present jsl __mul16\n\tplx\n\tplx\n\tsta\.b tcc__r0\n\tlda 4,s\n\tsta\.b tcc__r1\n\tjsl __div16
# a * b * c: the first product is pushed as the second call's operand.
in chained_mul: present jsl __mul16\n\tplx\n\tplx\n\tsta \d+,s\n\tpha\n\tlda 10,s\n\tpha\n\tjsl __mul16
# Powers of two and identities.
in mul_by_8: present lda 4,s\n(\tasl a\n){3}\trtl
in mul_by_zero: present lda\.w #0\n\trtl
in mul_by_one: present lda 4,s\n\trtl
in div_by_one: present lda 4,s\n\trtl
in mul_max: present lda\.w #65535\n\trtl
in mod_by_10: present lda\.w #10\n\tsta\.b tcc__r1\n\tjsl __mod16
