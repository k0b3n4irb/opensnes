# L2: a dense switch is a jump table (jt_find / emit_jt). The twin
# jump_table_off pins the compare tree; jump_table_tree the shapes that keep
# it with the table on.
# the shape pinned here is the text rules' and the slots' own: the X/Y colour
# (lot XY, 2026-11-14) would hold this case's counter or index in a register
# itself (its shapes: xy_colour.checks)
env QBE_NO_XY_COLOUR=1
in dense: present lda 4,s\n\tcmp\.w #8\n\tbcs @switch_default\.\d+\n\tasl a\n\ttax\n\tjmp \(@jtt\.\d+,x\)
in dense: present @jtt\.\d+:\n\t\.dw @switch_case\.\d+, @switch_case
in dense: absent cmp\.w #[1-7]\n
# the first case is not 0: a subtraction first, no default (the join)
in based: present sec\n\tsbc\.w #10\n\tcmp\.w #5\n\tbcs @switch_join
# -3..2 on a signed value: the window wraps, -3 is 65533 on 16 bits
in negative: present sbc\.w #65533\n\tcmp\.w #6\n
in negative: present jmp \(@jtt
# a byte: the zero extension is the value compared
in bytes: present and\.w #\$00FF\n@switch_cond\.\d+:\n\tcmp\.w #5\n\tbcs
# no default: the edges into the join carry r's old value (holes 0 and 3
# reach their own empty block, each a slot of the table)
in setter: present jmp \(@jtt
in setter: present cmp\.w #7\n
# shared labels, fallthrough, a default in the middle: stubs for the
# edges into a case that the zero of r reaches through a phi
in mixed: present sbc\.w #2\n\tcmp\.w #8\n
in mixed: present @jts\.\d+\.\d+:\n\tstz\.b tcc__lf\+\d+\n\tjmp @switch_case
in mixed: present \.dw @switch_case\.(\d+), @switch_case\.\1, @switch_case\.\1, @switch_default\.(\d+), @jts\.\d+\.\d+, @switch_default\.\2,
# in a loop indexed by its counter: the counter goes to Y, the dispatch
# takes X, each case gets X back from Y
in inloop: present ldy\.b tcc__lf\+\d+\n\tcpy\.w #16
in inloop: present asl a\n\ttax\n\tjmp \(@jtt
in inloop: present @switch_case\.\d+:\n\ttyx\n
absent cmp\.w #0\n\tbeq @switch
