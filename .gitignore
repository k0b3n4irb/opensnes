# Credentials
.env

# Build outputs
*.o
*.obj
*.a
*.lib
*.sfc
*.sym
*.map
*.oops
*.dbg

# Binary executables (rebuilt from source)
tools/font2snes/font2snes
tools/gfx4snes/gfx4snes
tools/img2snes/img2snes
tools/sa1-patch/sa1_patch
tools/smconv/smconv

# Generated documentation
doc/

# Compiler intermediates
*.ps
*.asp

# Tool outputs (gfx4snes, smconv)
*.pic
*.pal
*.brr
*.pc7
*.mp7
*.bnk
*.srm
*.inc
*_data.as

# WLA-DX
linkfile
testlink

# IDE (track shared VS Code config, ignore personal settings)
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/extensions.json
.idea/
*.swp
*.swo

# Python
__pycache__/
*.pyc

# macOS
.DS_Store
**/.DS_Store

# Claude Code project config — tracked, except for personal local overrides
.claude/settings.local.json

# Private game projects (never commit) — anchored to repo root so it
# doesn't accidentally match `.claude/notes/projects/` etc.
/projects/

# Build directories
build/
bin/
release/

# Temporary files
*.log
*.tmp
*.bak

# Generated build artifacts — TARGETED names only. Never reintroduce
# catch-alls (*.asm / *.bin / *.h): they silently swallow hand-written
# sources and shipped broken commits four times in one week (a .sym test
# fixture, libtest's data.asm, wavetable.bin — each caught by a red CI
# or a user, never by the author).
*.c.asm
*.wrap.asm
combined.asm
project_hdr.asm
project_sa1_boot.asm
soundbank.asm
soundbank.h
*.sfx.bin
*.sfx.link

# Negations for the remaining broad artifact rules (*.inc under "Tool
# outputs", *.pic/*.pal/*.map for the golden fixtures):
!lib/source/*.inc
!lib/include/**/*.inc
!templates/**/*.inc
!examples/**/hero*_meta.inc
!tests/**/*.inc
# Golden-output test fixtures for the asset tools — deliberately committed
# tool outputs (tools/*/tests/run_golden.py byte-compares against them).
!tools/*/tests/fixtures/*
!tools/*/tests/golden/*

.mcp.json
lib/source/audio_driver.spc700.bin
