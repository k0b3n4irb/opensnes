; A GSU job for the cache: 200 x 3000 additions of 7 (wrapping), about seven
; frames at 21 MHz, then the sum, the outer count left and a marker in Game
; Pak RAM. No CACHE, no LJMP, no ROM read: it can run from the code cache with
; the ROM left to the CPU (gsuCacheLoad + gsuStartCached).
.include "memmap_gsu.inc"

.BANK 0 SLOT 0
.ORG 0

gsu_start:
    IBT R0, #$70
    RAMB                    ; RAM bank for STW
    IWT R0, #0              ; accumulator
    IWT R4, #200            ; outer count
_outer:
    IWT R12, #3000          ; inner count (LOOP)
    MOVE R13, R15           ; inner loop address = next instruction
    ADD #7
    LOOP
    NOP
    DEC R4
    BNE _outer
    NOP
    IBT R1, #$00
    STW (R1)                ; SRAM[0..1] = 200*3000*7 mod 65536
    MOVE R0, R4
    IBT R1, #$02
    STW (R1)                ; SRAM[2..3] = 0 (outer count ran out)
    IWT R0, #$C0DE
    IBT R1, #$04
    STW (R1)                ; SRAM[4..5] = marker
    NOP
    STOP
    NOP

; A second entry point (2026-09-29, the <name>.sfx.h bridge): R1 x R2 by
; repeated addition, the product in SRAM[6..7]. R1 and R2 are the
; arguments, written by the CPU before the start (gsuCall /
; gsuStartCached with GSU_JOB_MUL_JOB).
mul_job:
    IBT R0, #$70
    RAMB
    IWT R0, #0
    MOVE R12, R2            ; LOOP count
    MOVE R13, R15           ; loop address = next instruction
    ADD R1
    LOOP
    NOP
    IBT R3, #$06
    STW (R3)                ; SRAM[6..7] = R1 * R2
    NOP
    STOP
    NOP

; A third entry point (2026-10-03, GSU_BANK): what only a program linked at
; its real address can do. It reads two bytes of a table that is part of the
; program (ROMB = the program's bank, R14 = the table's address), reaches
; its second half by an absolute jump, and leaves table[0] | table[1] << 8
; in SRAM[8..9]. Assembled at 0 and placed elsewhere, the GETB reads another
; part of the ROM and the jump leaves the program.
rom_job:
    IBT R0, #$70
    RAMB
    IBT R0, #GSU_BANK
    ROMB                    ; ROM bank for GETB = the program's bank
    IWT R14, #_rom_table    ; R14 = ROM address: the ROM buffer loads
    GETB                    ; R0 = table[0]
    MOVE R5, R0
    IWT R15, #_rom_far      ; absolute jump
    NOP
_rom_table:
    .db $A5, $3C
_rom_far:
    INC R14
    GETBH                   ; R0 = (table[1] << 8) | low byte of R5
    IBT R3, #$08
    STW (R3)                ; SRAM[8..9] = $3CA5
    NOP
    STOP
    NOP
