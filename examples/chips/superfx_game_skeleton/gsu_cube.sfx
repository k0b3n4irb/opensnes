; SuperFX (GSU) Wireframe — 34 coloured lines between points in SRAM, Bresenham + PLOT
;
; Derived from superfx_3d's renderer, made to run from the GSU code cache: its two CACHE
; instructions are gone (CACHE empties the cache and refetches from ROM,
; which the GSU does not own here), and it reads nothing from ROM. The CPU
; loads it with gsuCacheLoad() and starts it with gsuStartCached(): the ROM
; stays the CPU's, so the game loop keeps running during the job. It clears
; and draws the buffer at R8 (gsu_scbr x 1024, set by the launcher).
;
; Game Pak RAM, past the two framebuffers ($0000 and $4000):
;   $8000  x of the 19 points, one byte each (the CPU writes them every job)
;   $8020  y of the same points
;   $8040  the edge table, 34 x 3 bytes (point, point, colour), written once
;          at boot: the hologram's outer cube, its inner cube, the struts
;          between them and the projector's two beams, each in its own colour
;          of BG palette 0
; The CPU projects the points; joining them is the GSU's work, so the CPU
; sends 33 bytes a job (16 points and the centre's y) instead of 5 per edge.
; Edge-table pointer saved at $8100 (R12/R13 used by LOOP)
;
; Bresenham: PLOT with DEC R1 to compensate auto-increment.

.include "memmap_gsu.inc"

.BANK 0 SLOT 0
.ORG 0

.EQU POINT_X    $8000
.EQU POINT_Y    $8020
.EQU EDGE_DATA  $8040
.EQU PTR_SAVE   $8100
.EQU NUM_EDGES  34

gsu_start:
    IBT R0, #$70
    RAMB

    ; Clear framebuffer
    IWT R0, #$0000
    MOVE R1, R8
    IWT R4, #8192
_clear:
    STW (R1)
    INC R1
    INC R1
    DEC R4
    BNE _clear
    NOP

    IBT R0, #$00
    CMODE

    ; Init SRAM pointer
    IWT R0, #EDGE_DATA
    IWT R6, #PTR_SAVE
    STW (R6)

    ; Edge loop via LOOP (R12/R13)
    IWT R12, #NUM_EDGES
    MOVE R13, R15


_next_edge:
    ; Load pointer
    IWT R6, #PTR_SAVE
    LDW (R6)
    NOP
    MOVE R6, R0

    ; Read the edge: point a, point b, colour
    LDB (R6)
    NOP
    MOVE R7, R0             ; a (R7 is dx later, free until then)
    INC R6
    NOP
    LDB (R6)
    NOP
    MOVE R9, R0             ; b (R9 is sx later)
    INC R6
    NOP
    LDB (R6)
    NOP
    COLOR                   ; the edge's colour, from R0
    INC R6
    NOP

    ; Save updated pointer
    MOVE R0, R6
    IWT R6, #PTR_SAVE
    STW (R6)

    ; x0, y0 = point a; x1, y1 = point b
    IWT R0, #POINT_X
    ADD R7
    MOVE R6, R0
    LDB (R6)
    NOP
    MOVE R1, R0
    IWT R0, #POINT_Y
    ADD R7
    MOVE R6, R0
    LDB (R6)
    NOP
    MOVE R2, R0
    IWT R0, #POINT_X
    ADD R9
    MOVE R6, R0
    LDB (R6)
    NOP
    MOVE R3, R0
    IWT R0, #POINT_Y
    ADD R9
    MOVE R6, R0
    LDB (R6)
    NOP
    MOVE R4, R0

    ; === Bresenham setup ===
    ; dx = abs(x1-x0), sx = sign(x1-x0)
    MOVE R0, R3
    SUB R1
    NOP
    BPL _dx_pos
    NOP
    NOT
    NOP
    INC R0
    NOP
    IWT R9, #$FFFF
    BRA _dx_done
    NOP
_dx_pos:
    IWT R9, #$0001
_dx_done:
    MOVE R7, R0             ; R7 = dx (positive)

    ; dy = -abs(y1-y0), sy = sign(y1-y0)
    MOVE R0, R4
    SUB R2
    NOP
    BPL _dy_pos
    NOP
    ; y1 < y0: negate to get abs, then negate again for dy
    ; abs(y1-y0) = -(y1-y0) = y0-y1
    NOT
    NOP
    INC R0
    NOP
    ; dy = -abs = -(y0-y1) = y1-y0 (which is already negative)
    ; Oops, this double-negates. Let me rethink:
    ; R0 = y1-y0 (negative). abs = NOT+INC = -(y1-y0).
    ; dy = -abs = y1-y0 = R0 original. So for negative: dy = original R0.
    ; But we already NOT+INC'd it. We need to NOT+INC again... or just
    ; reload and negate:
    ; SIMPLER: reload, compute abs separately
    IWT R10, #$FFFF         ; sy = -1
    ; abs(y1-y0) = R0 (we just negated the negative value)
    ; dy = -abs = negate again
    NOT
    NOP
    INC R0
    NOP
    BRA _dy_done
    NOP

_dy_pos:
    IWT R10, #$0001         ; sy = +1
    ; R0 = y1-y0 (positive). dy = -abs = negate
    NOT
    NOP
    INC R0
    NOP

_dy_done:
    MOVE R8, R0             ; R8 = dy (negative)

    ; err = dx + dy
    MOVE R0, R7
    ADD R8
    NOP
    MOVE R5, R0

    ; === Bresenham pixel loop ===
_bres:
    PLOT
    DEC R1                  ; undo PLOT auto-increment
    NOP

    ; Done? x0==x1 && y0==y1
    MOVE R0, R1
    SUB R3
    NOP
    BNE _bres_cont
    NOP
    MOVE R0, R2
    SUB R4
    NOP
    BEQ _bres_done
    NOP

_bres_cont:
    ; e2 = 2 * err
    MOVE R0, R5
    ADD R5
    NOP
    MOVE R6, R0             ; R6 = e2

    ; if e2 >= dy: err += dy, x0 += sx
    SUB R8                  ; e2 - dy (subtracting negative = adding positive)
    NOP
    BMI _skip_x
    NOP
    MOVE R0, R5
    ADD R8
    NOP
    MOVE R5, R0
    MOVE R0, R1
    ADD R9
    NOP
    MOVE R1, R0
_skip_x:

    ; if e2 <= dx: err += dx, y0 += sy
    MOVE R0, R7
    SUB R6                  ; dx - e2
    NOP
    BMI _skip_y
    NOP
    MOVE R0, R5
    ADD R7
    NOP
    MOVE R5, R0
    MOVE R0, R2
    ADD R10
    NOP
    MOVE R2, R0
_skip_y:

    BRA _bres
    NOP

_bres_done:
    IBT R1, #$00
    RPIX

    LOOP
    NOP

    NOP
    NOP
    STOP
    NOP
