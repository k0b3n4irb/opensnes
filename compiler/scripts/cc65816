#!/bin/bash
# cc65816 - C compiler for 65816/SNES
# Uses cproc (C frontend) + QBE (optimizer) to generate WLA-DX assembly
#
# Usage: cc65816 input.c [-o output.asm]

set -e
set -o pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
CPROC="$SCRIPT_DIR/cproc-qbe"
QBE="$SCRIPT_DIR/qbe"

usage() {
    echo "Usage: cc65816 input.c [-o output.asm]"
    echo "  Compiles C source to 65816 assembly for SNES"
    echo ""
    echo "Options:"
    echo "  -o FILE    Output assembly to FILE (default: stdout)"
    echo "  -I DIR     Add include directory"
    echo "  -D NAME    Define preprocessor macro"
    echo "  -h         Show this help"
    exit 1
}

INPUT=""
OUTPUT=""
CFLAGS=()

while [[ $# -gt 0 ]]; do
    case $1 in
        -o)
            OUTPUT="$2"
            shift 2
            ;;
        -I|-D)
            CFLAGS+=("$1" "$2")
            shift 2
            ;;
        -I*|-D*)
            CFLAGS+=("$1")
            shift
            ;;
        -h|--help)
            usage
            ;;
        -*)
            echo "Unknown option: $1" >&2
            usage
            ;;
        *)
            if [[ -z "$INPUT" ]]; then
                INPUT="$1"
            else
                echo "Multiple input files not supported" >&2
                exit 1
            fi
            shift
            ;;
    esac
done

if [[ -z "$INPUT" ]]; then
    echo "Error: No input file specified" >&2
    usage
fi

if [[ ! -f "$INPUT" ]]; then
    echo "Error: Input file not found: $INPUT" >&2
    exit 1
fi

# Create unique temp files using mktemp
# -t template: portable across macOS, Linux, and Git Bash/MSYS on Windows
TMPFILE=$(mktemp -t cc65816.XXXXXX) || TMPFILE=$(mktemp)
IRFILE=$(mktemp -t cc65816_ir.XXXXXX) || IRFILE=$(mktemp)
CPROC_ERR=$(mktemp -t cc65816_cproc_err.XXXXXX) || CPROC_ERR=$(mktemp)
trap 'rm -f "$TMPFILE" "$IRFILE" "$CPROC_ERR"' EXIT

# Stage 1: Preprocess with system cc — with -undef and -nostdinc (2026-10-03):
# the host's predefined macros (__x86_64__, __aarch64__, __linux__…) made the
# same source give a different ROM on each build machine, and the host's
# <stdint.h> was read with cproc's sizes (int32_t came out 2 bytes, int64_t
# 4) without a word. Now a `#include <stdint.h>` fails at the preprocessor:
# use the fixed-width types of <snes/types.h>. The standard macros
# (__STDC__, __FILE__…) stay.
# `-D__OPENSNES__=1` lets headers detect that they're being preprocessed
# for the cc65816 target (vs the `clang -fsyntax-only` host lint pass
# in make/common.mk, which compiles the same source with host int/long
# sizes). lib/include/snes/types.h uses this to keep `sizeof(s32) == 4`
# on both code paths despite cc65816 having long=4 and host having long=8.
cc -E -undef -nostdinc -D__OPENSNES__=1 "${CFLAGS[@]}" "$INPUT" > "$TMPFILE"

# Cooper: under -g, tell cproc where to write the aggregate-layout sidecar
# (struct/array type trees for the debugger's Locals expansion).
if [[ -n "$CC65816_G" && -n "$OUTPUT" ]]; then
    export CC65816_DBG="${OUTPUT%.asm}.dbg"
fi

# Per-TU label prefix. cproc numbers anonymous local-linkage globals (string
# literals, __func__, compound literals) from a per-process counter that
# restarts at 0 every translation unit, and the w65816 backend strips QBE's
# ".L" local marker — so two .c files can ship the same global label
# (string.15) and wlalink rejects the duplicate. Passing a stable per-file stem
# lets cproc namespace those anonymous locals (<tu>_string.15) so they stay
# unique across TUs. Exported symbols (functions/globals) are untouched.
CC65816_TU=$(basename "$INPUT" | sed 's/\.[^.]*$//; s/[^A-Za-z0-9_]/_/g')
export CC65816_TU

# Stage 2: C frontend -> QBE IR (to temp file, NOT a pipe)
# Using a pipe hides cproc crashes: QBE receives truncated IR and reports
# misleading parse errors. With a temp file, cproc failures are caught cleanly.
#
# The retry-on-SIGSEGV loop that lived here (MSYS2 cproc segfaults, fixed by
# cproc ea95cac, 2026-03-07) was retired on 2026-09-26 (STRUCTURAL_DEFECTS
# A8): its telemetry counted zero retries over the observation window and
# over the last 25 Windows CI builds. A segfault is now an error like any
# other, named as such, instead of being absorbed.
set +e
"$CPROC" "$TMPFILE" > "$IRFILE" 2>"$CPROC_ERR"
CPROC_EXIT=$?
set -e
if [[ $CPROC_EXIT -ne 0 ]]; then
    cat "$CPROC_ERR" >&2
    if [[ $CPROC_EXIT -eq 139 ]]; then
        echo "cc65816: cproc crashed (SIGSEGV) on $(basename "$INPUT") — a compiler bug, please report it with this file" >&2
    fi
    exit $CPROC_EXIT
fi

# Audit aid: CC65816_KEEP_IR=<dir> keeps a copy of every TU's QBE IR
# (<dir>/<tu>.ssa) so corpus-wide IR properties can be counted — access
# flags, Kl temps, call shapes — without a second front-end run.
if [[ -n "${CC65816_KEEP_IR:-}" ]]; then
    _irname=$(printf '%s/%s' "$(pwd)" "$INPUT" | sed 's#^/##; s#[/ ]#__#g; s#\.c$##')
    mkdir -p "$CC65816_KEEP_IR" && cp "$IRFILE" "$CC65816_KEEP_IR/${_irname}.ssa"
fi

# Stage 3: QBE IR -> 65816 assembly
# Cooper source-level debug: CC65816_G=1 passes -g (keep C locals in memory) so
# the debugger can read typed locals. Off by default (it disables optimisation).
QBE_G=""
[[ -n "$CC65816_G" ]] && QBE_G="-g"
if [[ -z "$OUTPUT" ]]; then
    "$QBE" $QBE_G -t w65816 "$IRFILE"
else
    "$QBE" $QBE_G -t w65816 "$IRFILE" > "$OUTPUT"
    echo "Generated: $OUTPUT"
fi
